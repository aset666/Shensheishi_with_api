TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
# Send /id to your bot, then put your numeric Telegram ID here.
# To admit friends, add their IDs separated by commas.
ALLOWED_USER_IDS=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
MAX_DAILY_REQUESTS_PER_USER=25
MAX_DAILY_REQUESTS_TOTAL=100
MAX_VOICES_PER_USER=3
MAX_TEXT_LENGTH=3000
MAX_AUDIO_SECONDS=180
MAX_UPLOAD_MB=15
DATA_DIR=data
# Optional: set the path to ffmpeg if the bundled executable cannot run.
FFMPEG_EXE=
